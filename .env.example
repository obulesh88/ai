# Copy to .env and edit. NEVER put passwords or API keys in this file.
OLLAMA_HOST=http://127.0.0.1:11434
HEMA_MODEL=qwen3-coder-local:latest
HEMA_TIMEOUT=120
HEMA_MAX_CONTEXT=20

# Where HEMA may read/write files (default: ./workspace)
HEMA_WORKSPACE=

# Optional MCP server config file (JSON with an "mcpServers" object)
HEMA_MCP_CONFIG=
